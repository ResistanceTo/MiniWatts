    "BatteryCenter loaded and answered, but reported no connected devices. Its XPC to powerd is denied: the console shows _BCPowerSourceController \"Failed to obtain power sources info\"." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatteryCenter 已加载并有响应，但未报告任何已连接设备。它对 powerd 的 XPC 被拒绝：控制台会出现 _BCPowerSourceController “Failed to obtain power sources info”。"
          }
        }
      }
    },
    "BatteryCenter loaded but BCBatteryDeviceController is not in the runtime." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "BatteryCenter 已加载，但运行时中未找到 BCBatteryDeviceController。"
          }
        }
      }
    },
    "BatteryCenter.framework did not load: %@" : {
      "localizations" : {
