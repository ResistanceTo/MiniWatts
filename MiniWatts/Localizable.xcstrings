    "Power path" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "供电路径"
          }
        }
      }
    },
    "Power tier" : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "功率等级"
          }
        }
      }
    },
    "Radios" : {
